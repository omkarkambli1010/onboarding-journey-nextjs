<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy config for PRODUCTION.
  App served at:  https://diy.sbisecurities.in/open-nri-account/
  Node standalone server (run via NSSM/PM2) listens on 127.0.0.1:3000
  Requires IIS modules: URL Rewrite + Application Request Routing (ARR),
  with ARR proxy enabled (IIS Manager > server > Application Request Routing
  Cache > Server Proxy Settings > Enable proxy).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Static/public assets referenced at /open-nri-account/assets/* -->
        <rule name="onri-assets" stopProcessing="true">
          <match url="^open-nri-account/assets/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/open-nri-account/assets/{R:1}" />
        </rule>
        <!-- Everything else under the base path -> Next standalone server -->
        <rule name="onri-proxy" stopProcessing="true">
          <match url="^open-nri-account(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/open-nri-account{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Allow larger uploads (document/image upload flows) — 20 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

    <!-- Don't let IIS gzip the already-compressed proxied responses twice -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
